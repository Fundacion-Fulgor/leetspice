    "interface": {
      "subckt": "inverter",
      "pins": ["in", "out", "vdd", "vss"]
    },
    "editable_parameters": {
      "wn_um": {
        "minimum": 0.22,
        "maximum": 20.0,
        "default": 1.0
      },
      "wp_um": {
        "minimum": 0.22,
        "maximum": 40.0,
        "default": 2.0
      }
    },
    "fixed_parameters": {
      "vdd_v": 1.2,
      "channel_length_um": 0.13,
      "load_capacitance_pf": 0.02
    },
    "public_nodes": ["in", "out", "vdd", "vss"]
  },
  "checks": [
    {
      "id": "topology",
      "description": "Complementary pull-up and pull-down devices use the required pins.",
