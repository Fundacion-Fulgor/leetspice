      "operator": "equals",
      "target": 1,
      "unit": "boolean"
    },
    {
      "id": "score",
      "description": "Deterministic estimate balancing delay, power, and area.",
      "measurement": "mock score",
      "operator": "maximize",
      "target": 0,
      "unit": "points"
    }
  ],
  "limits": {
    "simulation_timeout_seconds": 5,
    "maximum_output_bytes": 262144
  }
