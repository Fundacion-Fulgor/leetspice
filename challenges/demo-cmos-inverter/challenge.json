  "submission": {"kind": "netlist"},
  "judge_backend": "cace",
  "judge_config": {},
  "score_unit": "points",
  "lower_is_better": false,
  "is_active": true,
  "circuit": {
    "simulator": "ngspice",
    "analysis": "mock-estimate",
    "pdk": {
      "name": "IHP SG13G2",
      "status": "target context only",
      "models_loaded": false,
      "note": "The PoC judge uses deterministic estimates or educational level-1 models, not SG13G2 compact models."
