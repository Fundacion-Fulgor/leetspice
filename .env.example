# Copy to .env before starting Compose. Never use these values in production.
POSTGRES_DB=leetspice
POSTGRES_USER=leetspice
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
WEB_PORT=8000
SECRET_KEY=generate-a-long-random-value

# cace runs real SG13G2 simulations. Use mock for web-only development.
RUNNER_BACKEND=cace
LEETSPICE_JUDGE_TIMEOUT=120
