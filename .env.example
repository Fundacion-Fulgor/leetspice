# Copy to .env before starting Compose. Never use these values in production.
POSTGRES_DB=leetspice
POSTGRES_USER=leetspice
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
WEB_PORT=8000
SECRET_KEY=generate-a-long-random-value

# Challenge manifests select real SG13G2 characterization. This fallback handles legacy jobs.
RUNNER_BACKEND=ngspice
LEETSPICE_JUDGE_TIMEOUT=120
LEETSPICE_LAYOUT_TIMEOUT=300
