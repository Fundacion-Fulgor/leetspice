# Copy to .env before starting Compose. Never use these values in production.
POSTGRES_DB=leetspice
POSTGRES_USER=leetspice
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
WEB_PORT=8000
SECRET_KEY=generate-a-long-random-value

# mock is deterministic and does not invoke ngspice. The experimental ngspice
# backend is intended only for controlled local evaluation; see docs/security.md.
RUNNER_BACKEND=mock
