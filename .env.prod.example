# LeetSpice Production Environment Variables
# Copy this file to .env before deploying: cp .env.prod.example .env

# Your server's domain name (used by Caddy for HTTPS)
# Example: DOMAIN=leetspice.youruniversity.edu
DOMAIN=localhost

# PostgreSQL credentials
POSTGRES_DB=leetspice_prod
POSTGRES_USER=leetspice_admin
# IMPORTANT: Change this to a strong, random password!
POSTGRES_PASSWORD=change-this-super-secret-db-password

# Application Security Key
# IMPORTANT: Generate a secure 32+ character random string for sessions
# (e.g. using `openssl rand -hex 32`)
SECRET_KEY=change-this-super-secret-app-key

# Runner backend to use for simulation verification (default: ngspice)
RUNNER_BACKEND=ngspice

# Optional timeouts for judges
LEETSPICE_JUDGE_TIMEOUT=120
LEETSPICE_LAYOUT_TIMEOUT=300
