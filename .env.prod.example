# LeetSpice Production Environment Variables
# Copy this file to .env before deploying: cp .env.prod.example .env

# ── Domain ────────────────────────────────────────────────────────
# Your server's domain name (Caddy auto-provisions HTTPS certificates)
# Example: DOMAIN=leetspice.youruniversity.edu
DOMAIN=localhost

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_DB=leetspice_prod
POSTGRES_USER=leetspice_admin
# IMPORTANT: Generate a strong password (e.g. openssl rand -base64 24)
POSTGRES_PASSWORD=CHANGE-ME-db-password

# Worker database user password (separate restricted user)
# IMPORTANT: Generate a different strong password
WORKER_DB_PASSWORD=CHANGE-ME-worker-password

# ── Application ───────────────────────────────────────────────────
# Session signing key. MUST be unique and secret.
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE-ME-app-secret-key

# ── Concurrency & Performance Tuning ──────────────────────────────
# Number of Uvicorn worker processes (typically 2 to 4 per CPU core)
WEB_CONCURRENCY=4

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Rate limits (requests per minute per IP)
RATE_LIMIT_DEFAULT=120/minute

# ── Runner & Judge Timeouts ───────────────────────────────────────
RUNNER_BACKEND=ngspice
LEETSPICE_JUDGE_TIMEOUT=120
LEETSPICE_LAYOUT_TIMEOUT=300
